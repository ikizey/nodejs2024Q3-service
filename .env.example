PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=homelib
POSTGRES_SCHEMA=public
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@$postgres:${POSTGRES_PORT}/${POSTGRES_DB}?schema=${POSTGRES_SCHEMA}

POSTGRES_LOGGING_COLLECTOR=on
POSTGRES_LOG_DIRECTORY=/var/log/postgresql
POSTGRES_LOG_FILENAME=postgresql-%Y-%m-%d_%H%M%S.log